# Copiar a .env y ajustar la instancia SQL Server instalada en Windows.
# Si es SQL Server Express suele ser: localhost\SQLEXPRESS
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=GestionDispositivosTI
# Generar una clave aleatoria larga con un gestor de secretos; no subir este dato a Git.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
